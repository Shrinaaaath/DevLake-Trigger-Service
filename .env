GITHUB_WEBHOOK_SECRET=my-secret
DEVLAKE_URL=http://localhost:8084
DEVLAKE_USERNAME=admin
DEVLAKE_PASSWORD=admin123
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
